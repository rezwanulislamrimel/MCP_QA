{
  "name": "qa-job-application-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first QA job discovery, matching, CV tailoring, and approval workflow.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "docx": "^9.15.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
