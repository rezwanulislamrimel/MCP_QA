# ==============================================================================
# AI QA Job Application Agent - Environment Configuration
# ==============================================================================

# Server Port (Default: 3030)
PORT=3030

# Candidate Name & Contact Details
APPLICANT_NAME=Rezwanul Rimel

# Scheduler Configuration (Asia/Dhaka timezone)
# Runs periodic background checks across internet job feeds
TIMEZONE=Asia/Dhaka
DAILY_SCHEDULE=0 */2 * * *

# ==============================================================================
# Auto-Apply Configuration (Direct Automatic Email Applications)
# ==============================================================================
# Set to 'true' to automatically send applications when a matching job with an email is found.
# Set to 'false' to keep applications waiting for your manual review click.
AUTO_APPLY_ENABLED=true
AUTO_APPLY_MIN_SCORE=40

# ==============================================================================
# Gmail Integration (Method 1: App Password - Fastest & Recommended)
# ==============================================================================
# 1. Enable 2-Step Verification on your Google account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Paste the password below:
GMAIL_USER=rezwanul.rimel97@gmail.com
GMAIL_APP_PASSWORD=

# ==============================================================================
# Gmail Integration (Method 2: Google Cloud Console OAuth 2.0 - Optional)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3030/oauth/gmail/callback

# Security Encryption Key (Minimum 16 characters)
APP_SECRET=rezwanul_rimel_qa_agent_secure_key_2026

# Optional: URL of an external approved public job feed returning JSON
CUSTOM_JOB_FEED_URL=
