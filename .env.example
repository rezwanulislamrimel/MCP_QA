# ==============================================================================
# AI QA Job Application Agent - Environment Configuration
# ==============================================================================

# Server Port (Default: 3030)
PORT=3030

# Scheduler Configuration (Default: Asia/Dhaka at 09:00 AM daily)
TIMEZONE=Asia/Dhaka
DAILY_SCHEDULE=0 9 * * *

# Security Encryption Key (Minimum 16 characters)
# Used to encrypt OAuth tokens stored in the local SQLite database.
# If left blank, a persistent random key will be generated in data/.secret
APP_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Optional: URL of an external approved public job feed returning JSON
CUSTOM_JOB_FEED_URL=

# ==============================================================================
# Google Cloud Console OAuth 2.0 (For Gmail Integration)
# ==============================================================================
# 1. Go to https://console.cloud.google.com/
# 2. Create a project and enable the "Gmail API".
# 3. Configure OAuth consent screen (User type: External / Testing; add your email as test user).
# 4. Create Credentials -> OAuth client ID -> Web application.
# 5. Add Authorized redirect URI: http://localhost:3030/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3030/oauth/gmail/callback

# ==============================================================================
# Microsoft Entra ID (Azure Portal) OAuth 2.0 (For Outlook Integration)
# ==============================================================================
# 1. Go to https://portal.azure.com/ -> Microsoft Entra ID -> App registrations.
# 2. Click "New registration", select "Accounts in any organizational directory and personal Microsoft accounts".
# 3. Add Redirect URI (Web): http://localhost:3030/oauth/outlook/callback
# 4. Under API permissions, add delegated permissions: "Mail.Send", "User.Read", "offline_access".
# 5. Under Certificates & secrets, generate a new Client secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3030/oauth/outlook/callback
